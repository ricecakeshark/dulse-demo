name "kelp-dev"
description "test app for kelp"
authors "RiceShark"
copyright "Copyright © 2025, RiceShark"
license "proprietary"

targetType "executable"
targetName "kelp-dev"
targetPath "build"

dependency "kelp-core" path="..\\kelp_core"
dependency "kelp-sdl"  path="..\\kelp_sdl"
dependency "kelp-gfx" path="..\\kelp_gfx"

lflags "/LIBPATH:$PACKAGE_DIR\\lib_st" "/LIBPATH:$PACKAGE_DIR\\lib_dy"
//libs "kelp_sdl" "kelp_render"

// SDL3 with kelp-sdl
lflags "/LIBPATH:$PACKAGE_DIR\\..\\kelp_sdl\\build"

// kelp_render
//libs "kelp_render"
lflags "/LIBPATH:$PACKAGE_DIR\\..\\kelp_gfx\\build"

buildType "release" {
	targetPath "release"
	//buildOptions "optimize"
}

buildType "debug" {
	targetPath "debug"
	//buildOptions "debugInfo"
}
