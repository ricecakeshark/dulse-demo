name "kelp-dev"
description "test app for kelp"
authors "RiceShark"
copyright "Copyright © 2025, RiceShark"
license "proprietary"

targetType "executable"
targetName "kelp-dev"
targetPath "build"

dependency "kelp-core" path="..\\kelp_core"
dependency "kelp-sdl"  path="..\\kelp_sdl"
dependency "kelp-gfx" path="..\\kelp_gfx"

lflags "/LIBPATH:$PACKAGE_DIR\\lib\\win_x86-64" platform="windows-x86_64"
copyFiles "lib\\win_x86-64\\*.dll" platform="windows-x86_64"
copyFiles "..\\build_shader\\build\\shader_builder.exe"
copyFiles "..\\build_shader\\build\\glslang.exe"

lflags "/LIBPATH:$PACKAGE_DIR\\lib_st" "/LIBPATH:$PACKAGE_DIR\\lib_dy"
//libs "kelp_sdl" "kelp_render"

// SDL3 with kelp-sdl
lflags "/LIBPATH:$PACKAGE_DIR\\..\\kelp_sdl\\build"

// kelp_gfx
//libs "kelp_render"
lflags "/LIBPATH:$PACKAGE_DIR\\..\\kelp_gfx\\build"

buildType "release" {
	targetPath "release"
}

buildType "debug" {
	targetPath "debug"
}
