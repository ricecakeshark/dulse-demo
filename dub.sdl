name "app"
description "test app for kelp"
authors "RiceShark"
copyright "Copyright © 2025, RiceShark"
license "proprietary"

dependency "kelp-core" path="..\\kelp_core"
dependency "kelp-api" path="..\\kelp_api"
dependency "kelp-loader" path="..\\kelp_loader"
dependency "kelp-sdl"  path="..\\kelp_sdl"
dependency "bindbc-sdl" version="~>2.2.2"
targetType "executable"
targetName "app"
targetPath "build"

libs "kelp_loader" "kelp_sdl" "SDL3"
subConfiguration "bindbc-sdl" "static"
versions "SDL_3_2_18"

importPaths "..\\kelp_loader\\include"
lflags "/LIBPATH:$PACKAGE_DIR\\lib_st" "/LIBPATH:$PACKAGE_DIR\\lib_dy"
